# ── Vesper server env — copy to /opt/vesper/.env on the box and fill in ──────
# docker-compose.prod.yml reads this via `--env-file .env`. NEVER commit the
# real file. DATABASE_URL is intentionally absent — compose derives it from
# POSTGRES_PASSWORD (postgresql://vesper:<pw>@postgres:5432/vesper_dev).

# Postgres password (also becomes the DB password the app connects with).
POSTGRES_PASSWORD=

# App origin = your box's Tailscale HTTPS URL (set up via `tailscale serve`).
# Signs Better Auth sessions/cookies and gates CSRF.
BETTER_AUTH_URL=https://vesper.tail488a59.ts.net
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Model providers. Leave OPENROUTER_API_KEY empty to run in demo mode
# (deterministic narrative + placeholder images, no external calls).
OPENROUTER_API_KEY=
VENICE_API_KEY=

# Shared password the seed sets on the Player + uxtest admin (lets the dev-gated
# impersonate endpoint mint a session). Pick something non-trivial here.
DEV_PASSWORD=

# Optional model overrides (defaults live in code; uncomment to change):
# NARRATIVE_MODEL=aion-labs/aion-2.0
# STATE_MODEL=google/gemini-2.5-flash
# TOOL_MODEL=google/gemini-2.5-flash
# EMBEDDING_MODEL=openai/text-embedding-3-small

LOG_LEVEL=info
ENABLE_TURN_INSPECTOR=false

# Venice image safety filter. The app's whole purpose is uncensored adult
# imagery, so on a PRIVATE single-user box "false" matches local dev. This is a
# conscious choice — never promote "false" to any shared/multi-user host.
VENICE_SAFE_MODE=false
