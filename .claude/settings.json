{
  "permissions": {
    "deny": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm verify)",
      "Bash(pnpm verify *)",
      "Bash(pnpm run verify)",
      "Bash(pnpm run verify *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm vitest)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm exec vitest)",
      "Bash(pnpm exec vitest *)",
      "Bash(npx vitest)",
      "Bash(npx vitest *)",
      "Bash(vitest)",
      "Bash(vitest *)",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh *)",
      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/verify.sh *)",
      "Bash(bash scripts/verify.sh)",
      "Bash(bash scripts/verify.sh *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm run build)",
      "Bash(pnpm run build *)",
      "Bash(tsc)",
      "Bash(tsc *)",
      "Bash(tsgo)",
      "Bash(tsgo *)",
      "Bash(eslint)",
      "Bash(eslint *)",
      "Bash(npx tsc)",
      "Bash(npx tsc *)",
      "Bash(npx eslint)",
      "Bash(npx eslint *)",
      "Bash(npx tsgo)",
      "Bash(npx tsgo *)",
      "Bash(pnpm exec tsc)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm dlx tsc)",
      "Bash(pnpm dlx tsc *)",
      "Bash(pnpm dlx eslint)",
      "Bash(pnpm dlx eslint *)",
      "Bash(next build)",
      "Bash(next build *)",
      "Bash(vite build)",
      "Bash(vite build *)",
      "Bash(turbo build)",
      "Bash(turbo build *)",
      "Bash(turbo run)",
      "Bash(turbo run *)",
      "Bash(node_modules/.bin/tsc)",
      "Bash(node_modules/.bin/tsc *)",
      "Bash(./node_modules/.bin/tsc)",
      "Bash(./node_modules/.bin/tsc *)",
      "Bash(node_modules/.bin/eslint)",
      "Bash(node_modules/.bin/eslint *)",
      "Bash(./node_modules/.bin/eslint)",
      "Bash(./node_modules/.bin/eslint *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.py\"",
            "timeout": 20,
            "statusMessage": "vesper preflight"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_policy.py\"",
            "timeout": 10,
            "statusMessage": "vesper agent policy"
          }
        ]
      }
    ]
  }
}
