# Dependencies & build output — reinstalled / rebuilt inside the image
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts

# Secrets & runtime data — never bake into the image
.env
.env.*
data/

# Caches, VCS, local tooling
.git
.github
.turbo/
.vitest-cache/
coverage/
.vscode
.idea
scratchpad/

# Local-only UI/QA artifacts — Playwright scratch + audit screenshots embed
# app-generated imagery; keep them out of the image.
.playwright-mcp/
docs/developer-notes/ux-audit-assets/

# Generated/eval imagery under docs — regenerable; text docs (.md) stay.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.webp
docs/**/*.avif
docs/**/*.bmp
docs/**/*.tif
docs/**/*.tiff
