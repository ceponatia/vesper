screenshots/
tmp/

# Evaluation and dev-task imagery — agent screenshots included — lives at the
# repository root and stays LOCAL (owner ruling 2026-08-28, #346). Never docs/.
eval-images/

# Render evidence IMAGES are local-only (owner ruling 2026-08-21): generated
# imagery must not enter git history. The verdict data beside them — README.md
# and scores CSVs — stays tracked; see evidence/README.md.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.gif
evidence/**/*.webp
evidence/**/*.avif
evidence/**/*.bmp
evidence/**/*.tif
evidence/**/*.tiff

