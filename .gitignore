node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
.env
data/
.vitest-cache/

# Local-only UI/QA artifacts — Playwright scratch + audit screenshots embed
# app-generated imagery; keep them on the server, never commit/push.
.playwright-mcp/

# Evaluation and dev-task imagery — agent screenshots included — lives at the
# repository root and stays LOCAL (owner ruling 2026-08-28, #346). Never docs/.
/eval-images/

# No raster imagery enters git anywhere (owner ruling 2026-08-28): eval renders,
# evidence, and screenshots are all local-only, regenerable artifacts. Already-
# tracked files (the app icons under apps/web/src/app) stay tracked; when the UI
# grows real image assets, carve them back in with a `!` negation here.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bmp
*.tif
*.tiff

# Tombstone: evidence/ was retired 2026-08-28 (its files left the index in
# 17a7090c), but a checkout that pulled before deleting may still hold them —
# keep resurrected copies out of `git add -A` (the `git doc` shortcut stages
# everything).
/evidence/

# Tombstone: screenshots/ was the destination for Playwright and manual
# UI-testing captures until 2026-08-28, when eval-images/ became the single
# home for every kind of evaluation and dev-task output. Nothing routes here
# any more; the pattern stays so a stale local folder cannot be staged.
screenshots/

# Python bytecode caches from the Cog/ComfyUI deployment under packages/image-sd/deployment.
__pycache__/
*.pyc

# Local cog build artifacts inside the SD deployment directory.
packages/image-sd/deployment/.cog/
