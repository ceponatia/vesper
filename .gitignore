# Local-only UI/QA artifacts — Playwright scratch + audit screenshots embed
# app-generated imagery; keep them on the server, never commit/push.
.playwright-mcp/
# Playwright/manual UI-testing screenshots live in screenshots/ (never the repo
# root or docs/) and stay LOCAL — they are ephemeral working artifacts.
screenshots/

# Render evidence IMAGES are local-only (owner ruling 2026-08-21): generated
# imagery must not enter git history. The verdict data beside them — README.md
# and scores CSVs — stays tracked; see evidence/README.md.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.gif
evidence/**/*.webp
evidence/**/*.avif
evidence/**/*.bmp
evidence/**/*.tif
evidence/**/*.tiff
docs/developer-notes/ux-audit-assets/
docs/prompts/

# Generated/eval imagery under docs — regenerable, keep out of git.
# Text docs (.md) stay tracked; app icons under src/app are unaffected.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.webp
docs/**/*.avif
docs/**/*.bmp
docs/**/*.tif
docs/**/*.tiff


