{
  // Vesper — VS Code workspace. Open via File > Open Workspace from File…
  "folders": [
    {
      "name": "vesper",
      "path": "."
    }
  ],
  "settings": {
    // ── Explorer: file nesting ────────────────────────────────────────────
    // Tests nest under the file they exercise (merge.ts ▸ merge.test.ts,
    // merge.affinity.test.ts, merge.time.test.ts, engine.int.test.ts …);
    // root tooling configs nest under package.json. Note: setting
    // `patterns` replaces the defaults, so the useful defaults are
    // restated here.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.test.ts, ${capture}.int.test.ts, ${capture}.*.test.ts",
      "*.tsx": "${capture}.test.ts, ${capture}.test.tsx, ${capture}.*.test.ts",
      "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc, eslint.config.*, postcss.config.*, vitest.config.*, drizzle.config.*, .gitignore",
      "next.config.ts": "next-env.d.ts",
      "tsconfig.json": "tsconfig.*.json, tsconfig.tsbuildinfo",
      "docker-compose.yml": "docker-compose.*.yml",
      ".env.example": ".env, .env.*",
      "README.md": "AGENTS.md, CLAUDE.md",
      // developer-notes convention: phase-N-plan.md is the anchor; any
      // file named *.phaseN.md nests under it, as do the existing
      // phase-N.md findings docs and the multi-character phase plans.
      "phase-*-plan.md": "phase-${capture}.md, multi-character-phase-${capture}-plan.md, *.phase${capture}.md"
    },
    // ── TypeScript ────────────────────────────────────────────────────────
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    // ── Lint / format (no prettier in this repo — ESLint is the tool) ────
    "eslint.useFlatConfig": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    // ── Tailwind v4 ───────────────────────────────────────────────────────
    "files.associations": {
      "*.css": "tailwindcss"
    },
    // The repo's class-combining helper (src/components/ui/cx.ts) gets
    // Tailwind completions/hover inside its arguments.
    "tailwindCSS.classFunctions": [
      "cx"
    ],
    // ── pnpm ──────────────────────────────────────────────────────────────
    "npm.packageManager": "pnpm",
    // ── Noise control ─────────────────────────────────────────────────────
    "files.exclude": {
      "**/.next": true,
      "tsconfig.tsbuildinfo": true
    },
    "search.exclude": {
      "**/.next": true,
      "pnpm-lock.yaml": true,
      "drizzle/meta": true,
      "data": true
    },
    "files.watcherExclude": {
      "**/.next/**": true,
      "**/data/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "vitest.explorer",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "configurations": [
      {
        // Starts `pnpm dev` (port 3200) with the server debugger attached,
        // then opens Chrome with the client debugger once Next reports ready.
        "name": "Next.js: debug full stack",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev",
        "serverReadyAction": {
          "pattern": "- Local:.+(https?://.+)",
          "uriFormat": "%s",
          "action": "debugWithChrome",
          "killOnServerStop": true
        }
      },
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev"
      },
      {
        // Attach to an already-running `pnpm dev`.
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3200",
        "webRoot": "${workspaceFolder}"
      },
      {
        // Debug the test file open in the editor (unit or .int.test —
        // integration files need the dev Postgres running).
        "name": "Vitest: debug current file",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
        "args": [
          "run",
          "${relativeFile}"
        ],
        "cwd": "${workspaceFolder}",
        "autoAttachChildProcesses": true,
        "smartStep": true,
        "console": "integratedTerminal",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev",
        "type": "shell",
        "command": "pnpm dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "test (pure)",
        "type": "shell",
        "command": "pnpm test",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "test (integration — needs Postgres)",
        "type": "shell",
        "command": "pnpm test:int",
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "typecheck",
        "type": "shell",
        "command": "pnpm typecheck",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$tsc"
        ]
      },
      {
        "label": "lint",
        "type": "shell",
        "command": "pnpm lint",
        "problemMatcher": [
          "$eslint-stylish"
        ]
      },
      {
        "label": "db: start (docker)",
        "type": "shell",
        "command": "docker compose up -d",
        "problemMatcher": []
      },
      {
        "label": "db: generate migration",
        "type": "shell",
        "command": "pnpm db:generate",
        "problemMatcher": []
      },
      {
        "label": "db: migrate",
        "type": "shell",
        "command": "pnpm db:migrate",
        "problemMatcher": []
      },
      {
        "label": "db: studio",
        "type": "shell",
        "command": "pnpm db:studio",
        "isBackground": true,
        "problemMatcher": []
      }
    ]
  }
}