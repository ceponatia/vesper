{
  // Vesper — VS Code workspace. Open via File > Open Workspace from File…
  "folders": [
    {
      "name": "vesper",
      "path": "."
    }
  ],
  "settings": {
    // ── Explorer: file nesting ────────────────────────────────────────────
    // Nesting patterns live in .vscode/settings.json — the folder settings
    // take precedence over this file for that object setting, so a second
    // copy here would be masked (that split is exactly what once left
    // deferred/ plan families flat). Keep all nesting config there.
    // ── TypeScript ────────────────────────────────────────────────────────
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    // ── Lint / format (no prettier in this repo — ESLint is the tool) ────
    "eslint.useFlatConfig": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    // ── Tailwind v4 ───────────────────────────────────────────────────────
    "files.associations": {
      "*.css": "tailwindcss"
    },
    // The repo's class-combining helper (src/components/ui/cx.ts) gets
    // Tailwind completions/hover inside its arguments.
    "tailwindCSS.classFunctions": [
      "cx"
    ],
    // ── pnpm ──────────────────────────────────────────────────────────────
    "npm.packageManager": "pnpm",
    // ── Noise control ─────────────────────────────────────────────────────
    "files.exclude": {
      "**/.next": true,
      "**/tsconfig.tsbuildinfo": true
    },
    "search.exclude": {
      "**/.next": true,
      "pnpm-lock.yaml": true,
      "drizzle/meta": true,
      "data": true
    },
    "files.watcherExclude": {
      "**/.next/**": true,
      "**/data/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "vitest.explorer",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "configurations": [
      {
        // Starts `pnpm dev` (port 3200) with the server debugger attached,
        // then opens Chrome with the client debugger once Next reports ready.
        "name": "Next.js: debug full stack",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev",
        "serverReadyAction": {
          "pattern": "- Local:.+(https?://.+)",
          "uriFormat": "%s",
          "action": "debugWithChrome",
          "killOnServerStop": true
        }
      },
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev"
      },
      {
        // Attach to an already-running `pnpm dev`.
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3200",
        "webRoot": "${workspaceFolder}/apps/web"
      },
      {
        // Debug the test file open in the editor (unit or .int.test —
        // integration files need the dev Postgres running).
        "name": "Vitest: debug current file",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
        "args": [
          "run",
          "${relativeFile}"
        ],
        "cwd": "${workspaceFolder}",
        "autoAttachChildProcesses": true,
        "smartStep": true,
        "console": "integratedTerminal",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev",
        "type": "shell",
        "command": "pnpm dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "test (pure)",
        "type": "shell",
        "command": "pnpm test",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "test (integration — needs Postgres)",
        "type": "shell",
        "command": "pnpm test:int",
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "typecheck",
        "type": "shell",
        "command": "pnpm typecheck",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$tsc"
        ]
      },
      {
        "label": "lint",
        "type": "shell",
        "command": "pnpm lint",
        "problemMatcher": [
          "$eslint-stylish"
        ]
      },
      {
        "label": "db: start (docker)",
        "type": "shell",
        "command": "docker compose up -d",
        "problemMatcher": []
      },
      {
        "label": "db: generate migration",
        "type": "shell",
        "command": "pnpm db:generate",
        "problemMatcher": []
      },
      {
        "label": "db: migrate",
        "type": "shell",
        "command": "pnpm db:migrate",
        "problemMatcher": []
      },
      {
        "label": "db: studio",
        "type": "shell",
        "command": "pnpm db:studio",
        "isBackground": true,
        "problemMatcher": []
      }
    ]
  }
}