{
  "name": "vesper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src scripts",
    "typecheck": "tsc --noEmit",
    "jscpd": "jscpd",
    "jscpd:clones": "jscpd --reporters console",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:watch": "vitest --exclude '**/*.int.test.ts'",
    "test:int": "vitest run --no-file-parallelism .int.test.",
    "test:engine-e2-2": "vitest run --no-file-parallelism --testNamePattern E2.2 src/server/engine/simulation/item-transfer-store.int.test.ts",
    "verify": "pnpm lint && pnpm lint:cycles && pnpm typecheck && pnpm test && pnpm jscpd",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:create": "tsx scripts/db-create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backfill-image-refs": "tsx scripts/backfill-image-references.ts",
    "eval:narration": "tsx scripts/eval/narration/run.ts",
    "eval:narration:compare": "tsx scripts/eval/narration/compare.ts",
    "eval:engine-baseline": "tsx scripts/eval/engine-baseline/run.ts",
    "eval:engine-gate1": "tsx scripts/eval/engine-gate1/run.ts",
    "eval:engine-gate2-soak": "tsx scripts/eval/engine-gate2-soak/run.ts",
    "eval:schedule-kind": "tsx scripts/eval/schedule-kind/run.ts",
    "eval:retrieval": "tsx scripts/eval/retrieval/run.ts",
    "test:engine-e2-3": "vitest run --no-file-parallelism --testNamePattern E2.3 src/server/engine/simulation/item-transfer-store.int.test.ts",
    "test:engine-e2-4": "vitest run --no-file-parallelism src/server/engine/simulation/scheduler-store.int.test.ts",
    "test:engine-e2-5": "vitest run --no-file-parallelism src/server/engine/simulation/branch-store.int.test.ts",
    "test:engine-e2-6": "vitest run --no-file-parallelism src/server/engine/simulation/gate2-soak.int.test.ts",
    "test:engine-e3-1": "vitest run --no-file-parallelism src/lib/simulation/space.test.ts src/contracts/simulation/space.test.ts src/server/engine/simulation/space-store.int.test.ts",
    "test:engine-e3-2": "vitest run --no-file-parallelism src/lib/simulation/activities.test.ts src/server/engine/simulation/activity-store.int.test.ts",
    "test:engine-e3-3": "vitest run --no-file-parallelism src/lib/simulation/commitments.test.ts src/server/engine/simulation/commitment-store.int.test.ts",
    "test:engine-e3-4": "vitest run --no-file-parallelism src/lib/simulation/engagements.test.ts src/server/engine/simulation/engagement-store.int.test.ts",
    "test:engine-e3-5": "vitest run --no-file-parallelism src/lib/simulation/narrative.test.ts src/server/engine/simulation/gate3-corpus.int.test.ts",
    "test:engine-e4-1": "vitest run --no-file-parallelism src/lib/simulation/perception.test.ts src/server/engine/simulation/observation-store.int.test.ts",
    "test:engine-e4-2": "vitest run --no-file-parallelism src/lib/simulation/knowledge.test.ts src/server/engine/simulation/knowledge-store.int.test.ts",
    "test:engine-e4-3": "vitest run --no-file-parallelism src/lib/simulation/narrative.test.ts src/lib/simulation/presentation.test.ts src/lib/simulation/soft-canon.test.ts src/lib/simulation/deliberation.test.ts src/server/engine/simulation/narrative-store.int.test.ts src/server/engine/simulation/gate3-corpus.int.test.ts",
    "test:engine-e4-4": "vitest run --no-file-parallelism src/lib/simulation/memory.test.ts src/server/engine/simulation/memory-store.int.test.ts",
    "test:engine-e4-5": "vitest run --no-file-parallelism src/server/engine/simulation/gate4-corpus.int.test.ts",
    "test:engine-e5-1": "vitest run --no-file-parallelism src/lib/simulation/bodies.test.ts src/server/engine/simulation/body-store.int.test.ts",
    "test:engine-e5-2": "vitest run --no-file-parallelism src/lib/simulation/body-reads.test.ts src/server/engine/simulation/body-store.int.test.ts",
    "test:engine-e5-3": "vitest run --no-file-parallelism src/lib/simulation/materials.test.ts src/server/engine/simulation/material-store.int.test.ts src/lib/simulation/activities.test.ts src/server/engine/simulation/activity-store.int.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "ai": "^6.0.201",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
