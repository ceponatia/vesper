{
  "name": "vesper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/web.mjs dev --turbopack -p 3200",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start -p 3200",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json apps/web/src scripts packages",
    "lint:authz": "tsx scripts/check-route-authz.ts",
    "lint:package-boundaries": "tsx scripts/check-workspace-imports.ts",
    "lint:package-resolution": "tsx scripts/check-package-resolution.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p packages/contracts/tsconfig.json && tsc -p packages/image-core/tsconfig.json && tsc -p packages/image-replicate/tsconfig.json",
    "jscpd": "jscpd",
    "jscpd:clones": "jscpd --reporters console",
    "test": "vitest run --project=app --project=contracts --project=image-core --project=image-replicate",
    "test:watch": "vitest --project=app --project=contracts --project=image-core --project=image-replicate",
    "test:int": "vitest run --no-file-parallelism --project=app-int",
    "test:int:strict": "REQUIRE_INTEGRATION_DB=true vitest run --no-file-parallelism --project=app-int",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh full",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:create": "tsx scripts/db-create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backfill-image-refs": "tsx scripts/backfill-image-references.ts",
    "db:backfill-registry-defaults": "tsx scripts/backfill-registry-defaults.ts",
    "eval:engine-gate1": "tsx scripts/eval/engine-gate1/run.ts",
    "eval:engine-gate2-soak": "tsx scripts/eval/engine-gate2-soak/run.ts",
    "sim:seed": "tsx scripts/sim/seed-rollout-world.ts",
    "sim:advance": "tsx scripts/sim/advance-rollout-world.ts",
    "sim:render-turn": "tsx scripts/sim/render-turn.ts",
    "sim:shadow-corpus": "tsx scripts/sim/shadow-corpus.ts",
    "report:npc-scene-decisions": "tsx scripts/npc-scene-decision-report.ts",
    "eval:schedule-kind": "tsx scripts/eval/schedule-kind/run.ts",
    "eval:affordance-cues": "tsx scripts/eval/affordance-cues/run.ts",
    "eval:retrieval": "tsx scripts/eval/retrieval/run.ts",
    "test:engine": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation apps/web/src/server/engine/sim-narrator.int.test.ts apps/web/src/app/api/chats/sim-routes.int.test.ts apps/web/src/app/api/admin/engine-authority/engine-authority.int.test.ts apps/web/src/app/api/admin/sim/sim-admin.int.test.ts apps/web/src/server/images/path-containment.int.test.ts apps/web/src/server/images/route-safe.int.test.ts apps/web/src/server/images/model-profiles.int.test.ts apps/web/src/server/db/identity-packs-schema.int.test.ts apps/web/src/server/db/identity-pack-trial-schema.int.test.ts apps/web/src/server/images/identity-packs.int.test.ts apps/web/src/server/images/identity-pack-lifecycle.int.test.ts apps/web/src/server/images/identity-pack-trial.int.test.ts apps/web/src/server/images/image-lab.int.test.ts 'apps/web/src/app/api/characters/[id]/identity-pack/identity-pack-routes.int.test.ts' 'apps/web/src/app/api/admin/self/identity-packs/trial/trial-routes.int.test.ts'",
    "test:engine-e2-4": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/scheduler-store.int.test.ts",
    "test:engine-e2-5": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/branch-store.int.test.ts",
    "test:engine-e2-6": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/gate2-soak.int.test.ts",
    "test:engine-e3-1": "vitest run --no-file-parallelism apps/web/src/lib/simulation/space.test.ts apps/web/src/contracts/simulation/space.test.ts apps/web/src/server/engine/simulation/space-store.int.test.ts",
    "test:engine-e3-2": "vitest run --no-file-parallelism apps/web/src/lib/simulation/activities.test.ts apps/web/src/server/engine/simulation/activity-store.int.test.ts",
    "test:engine-e3-3": "vitest run --no-file-parallelism apps/web/src/lib/simulation/commitments.test.ts apps/web/src/server/engine/simulation/commitment-store.int.test.ts",
    "test:engine-e3-4": "vitest run --no-file-parallelism apps/web/src/lib/simulation/engagements.test.ts apps/web/src/server/engine/simulation/engagement-store.int.test.ts",
    "test:engine-e3-5": "vitest run --no-file-parallelism apps/web/src/lib/simulation/narrative.test.ts apps/web/src/server/engine/simulation/gate3-corpus.int.test.ts",
    "test:engine-e4-1": "vitest run --no-file-parallelism apps/web/src/lib/simulation/perception.test.ts apps/web/src/server/engine/simulation/observation-store.int.test.ts",
    "test:engine-e4-2": "vitest run --no-file-parallelism apps/web/src/lib/simulation/knowledge.test.ts apps/web/src/server/engine/simulation/knowledge-store.int.test.ts",
    "test:engine-e4-3": "vitest run --no-file-parallelism apps/web/src/lib/simulation/narrative.test.ts apps/web/src/lib/simulation/presentation.test.ts apps/web/src/lib/simulation/soft-canon.test.ts apps/web/src/lib/simulation/deliberation.test.ts apps/web/src/server/engine/simulation/narrative-store.int.test.ts apps/web/src/server/engine/simulation/gate3-corpus.int.test.ts",
    "test:engine-e4-4": "vitest run --no-file-parallelism apps/web/src/lib/simulation/memory.test.ts apps/web/src/server/engine/simulation/memory-store.int.test.ts",
    "test:engine-e4-5": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/gate4-corpus.int.test.ts",
    "test:engine-e5-1": "vitest run --no-file-parallelism apps/web/src/lib/simulation/bodies.test.ts apps/web/src/server/engine/simulation/body-store.int.test.ts",
    "test:engine-e5-2": "vitest run --no-file-parallelism apps/web/src/lib/simulation/body-reads.test.ts apps/web/src/server/engine/simulation/body-store.int.test.ts",
    "test:engine-e5-3": "vitest run --no-file-parallelism apps/web/src/lib/simulation/materials.test.ts apps/web/src/server/engine/simulation/material-store.int.test.ts apps/web/src/lib/simulation/activities.test.ts apps/web/src/server/engine/simulation/activity-store.int.test.ts",
    "test:engine-e5-4": "vitest run --no-file-parallelism apps/web/src/lib/simulation/households.test.ts apps/web/src/server/engine/simulation/household-store.int.test.ts apps/web/src/lib/simulation/materials.test.ts apps/web/src/server/engine/simulation/branch-store.int.test.ts",
    "test:engine-e5-5": "vitest run --no-file-parallelism apps/web/src/lib/simulation/social.test.ts apps/web/src/lib/simulation/commitments.test.ts apps/web/src/lib/simulation/engagements.test.ts apps/web/src/lib/simulation/activities.test.ts apps/web/src/lib/simulation/narrative.test.ts apps/web/src/server/engine/simulation/social-store.int.test.ts apps/web/src/server/engine/simulation/commitment-store.int.test.ts",
    "test:engine-e5-6": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/gate5-corpus.int.test.ts",
    "test:engine-e6-1": "vitest run --no-file-parallelism apps/web/src/lib/simulation/lod.test.ts apps/web/src/server/engine/simulation/lod-store.int.test.ts apps/web/src/server/engine/simulation/narrative-store.int.test.ts",
    "test:engine-e6-2": "vitest run --no-file-parallelism apps/web/src/lib/simulation/routine.test.ts apps/web/src/lib/simulation/lod.test.ts apps/web/src/server/engine/simulation/routine-store.int.test.ts apps/web/src/server/engine/simulation/lod-store.int.test.ts",
    "test:engine-e6-3": "vitest run --no-file-parallelism apps/web/src/lib/simulation/lod.test.ts apps/web/src/lib/simulation/bodies.test.ts apps/web/src/lib/simulation/replay.test.ts apps/web/src/lib/simulation/cohorts.test.ts apps/web/src/server/engine/simulation/lod-store.int.test.ts apps/web/src/server/engine/simulation/body-store.int.test.ts apps/web/src/server/engine/simulation/cohort-store.int.test.ts",
    "test:engine-e6-4": "vitest run --no-file-parallelism apps/web/src/lib/simulation/promotion.test.ts apps/web/src/lib/simulation/cohorts.test.ts apps/web/src/lib/simulation/lod.test.ts apps/web/src/server/engine/simulation/promotion-store.int.test.ts apps/web/src/server/engine/simulation/engagement-store.int.test.ts apps/web/src/server/engine/simulation/body-store.int.test.ts",
    "test:engine-e6-5": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/gate6-corpus.int.test.ts",
    "test:rollout-r1": "vitest run --no-file-parallelism apps/web/src/server/engine/simulation/rollout-world.int.test.ts apps/web/src/app/api/admin/engine-authority/engine-authority.int.test.ts",
    "test:rollout-r2": "vitest run --no-file-parallelism apps/web/src/server/engine/sim-narrator.int.test.ts",
    "test:rollout-r3": "vitest run --no-file-parallelism apps/web/src/app/api/chats/sim-routes.int.test.ts apps/web/src/server/engine/simulation/rollout-world.int.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@vesper/image-core": "workspace:*",
    "@vesper/image-replicate": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vesper/contracts": "workspace:*",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
