{
  "name": "vesper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "jscpd": "jscpd",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:watch": "vitest --exclude '**/*.int.test.ts'",
    "test:int": "vitest run --no-file-parallelism .int.test.",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm jscpd",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:create": "tsx scripts/db-create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db-seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "ai": "^6.0.201",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "lint-staged": "^17.0.7",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
