# Database (local Vesper Postgres container; see docker-compose.yml)
DATABASE_URL="postgresql://vesper:vesper_dev_password@localhost:5435/vesper_dev"

# OpenRouter: narrative/state/tool models, embeddings, text-to-image.
# Leave unset to run in demo mode (deterministic narrative, placeholder images).
OPENROUTER_API_KEY=""

# Venice: reference-based image editing (portrait variants, scene images).
VENICE_API_KEY=""

# Text models (narrator, in-session agents, scene composer, embeddings) are NOT
# env-configurable — pick the narrator/agent model in code (lib/narrative-models.ts,
# lib/agent-models.ts) or per-world in the UI (world creation + World tab). The
# embedding model defaults in code (server/ai/provider.ts MODEL_DEFAULTS).
#
# Image generation is Venice/Qwen end-to-end (OpenRouter is text-only since the
# 2026-06-19 Flux removal). Models default in code; uncomment to override:
# VENICE_IMAGE_MODEL="qwen-image-2"            # text-to-image (avatars, entities, t2i fallback)
# VENICE_IMAGE_EDIT_MODEL="qwen-image-2-edit"  # single-reference edit (portrait variants + scene images)
# VENICE_MULTI_EDIT_MODEL="qwen-edit-uncensored" # multi-reference edit (/image/multi-edit, ≤3 refs)
# VENICE_SAFE_MODE="false" disables Venice's image-generation safety filter.
# This is a conscious, explicit choice — do NOT promote this value blindly to
# any shared or production environment. Leave "true" (the Venice default) unless
# you specifically need uncensored image output in a controlled dev/local setup.
VENICE_SAFE_MODE="false"

LOG_LEVEL="info"

# Turn inspector (admin debug view of a turn's pipeline). Off by default — the
# route 404s unless this is "true" AND the caller is an admin (security I4).
ENABLE_TURN_INSPECTOR="false"

# Auth (Better Auth — auth.plan.md). Secret signs sessions/cookies; generate with
# `openssl rand -base64 32`. URL is the app origin (used for OAuth callbacks + CSRF).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3200"
# Extra trusted origins (comma-separated) beyond BETTER_AUTH_URL. Add the dev
# machine's LAN address to sign in from a phone on the same Wi-Fi — otherwise
# Better Auth rejects it with "Invalid origin". e.g.:
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3200,http://192.168.1.64:3200"
BETTER_AUTH_TRUSTED_ORIGINS=""

# Self-service sign-up. OFF unless set to "true" — only seeded/approved accounts
# can sign in. To register a new account: set "true", restart, sign up, then set
# back to "false". On Fly: `fly secrets set ALLOW_SIGNUP=true -a vesper` / `=false`.
ALLOW_SIGNUP="false"

# Social OAuth (each pair optional; a provider is enabled only when BOTH are set,
# and degrades quietly otherwise — no boot crash).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Magic-link email transport. v1 implements NO sender, so magic-link sign-in is
# DEV-ONLY: in dev the link is logged to the server console (grep
# "auth.magic_link"), while a production process drops the plugin entirely rather
# than write a live sign-in URL into log retention (security-authz.plan.md slice 1).
# The two names below are RESERVED for a future implemented sender and are INERT —
# setting them activates nothing. What turns production magic-link on is registering
# a real transport in src/server/auth/magic-link.ts (its factory then reads its own
# var); env presence alone never enables a sign-in method that can't deliver.
# RESEND_API_KEY=""
# SMTP_URL=""

# Dev/QA only: shared password the seed sets on the Player + uxtest admin so the
# dev-gated POST /api/dev/impersonate can mint a real signed session for them.
DEV_PASSWORD="vesper-dev-password"

# Rate limits & cost controls (rate-limits.plan.md). Burst windows are in-code;
# these bound DURABLE per-account spend and are counted in provider CALLS (not
# currency — per-model prices live outside the app and would rot here). All
# optional: each falls back to the code default, and a non-positive or
# unparseable value is ignored rather than trusted.
# LIMIT_PROVIDER_TEXT_DAY="1000"           # narrative/agent/tool model calls per account per UTC day
# LIMIT_PROVIDER_IMAGE_DAY="200"           # image renders per account per UTC day
# LIMIT_PROVIDER_EMBED_DAY="5000"          # embedding calls per account per UTC day
# LIMIT_UPLOAD_BYTES_DAY="524288000"       # player-supplied bytes accepted per account per UTC day (500 MB)
# LIMIT_STORAGE_BYTES="2147483648"         # total stored image bytes per account (2 GB)
