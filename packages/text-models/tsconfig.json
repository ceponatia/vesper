{
  // The package's own TypeScript project. It extends only tsconfig.base.json —
  // the language level and strictness contract — never the application project,
  // so this package proves it typechecks on its own terms rather than because
  // the Next application lends it aliases, ambient generated types, or its
  // TypeScript plugin.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2022 and nothing else. An adapter is a description of how one model
    // differs, expressed as pure data and pure functions: no clock, no network,
    // no filesystem, no environment. The empty `types` list is what keeps it
    // that way — a quirk that reached for `process` to read a host selection
    // from the environment would fail to compile here before
    // `pnpm lint:package-boundaries` ever saw it, and reading the environment
    // is precisely what the host parameter exists to avoid.
    "lib": ["ES2022"],
    "types": []
  },
  // `vitest.config.ts` is listed so the package's own test config is covered by
  // a project: type-aware ESLint parses only files a tsconfig claims, and an
  // unclaimed config file fails the lint gate rather than going unchecked.
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
