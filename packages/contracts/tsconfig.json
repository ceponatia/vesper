{
  // The package's own TypeScript project. It extends only tsconfig.base.json —
  // the language level and strictness contract — and never the application
  // project: the point is to prove this package typechecks on its own terms
  // rather than because the Next application lends it aliases, ambient
  // generated types, or its TypeScript plugin. The base deliberately carries no
  // `lib`, `types`, `jsx`, `paths` or plugins, so extending it grants nothing.
  // Root `pnpm typecheck` runs this project alongside the app and the other
  // package projects.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2022 + DOM, matching image-core: DOM is the only library declaring the
    // web-standard globals a universal package may use. It is NOT permission to
    // touch `document`/`window` — `pnpm lint:package-boundaries` rejects
    // evaluating those along with the Node-only globals.
    "lib": ["ES2022", "DOM"],
    // No ambient type packages at all. image-core carries `["node"]` because a
    // provider seam names `Buffer` in a type position; nothing here names a
    // platform type, so the honest set is empty — and an empty set is what stops
    // the root install's `@types/*` from quietly establishing this package.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
