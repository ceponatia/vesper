{
  // The package's own TypeScript project. It extends only tsconfig.base.json —
  // the language level and strictness contract — and never the application
  // project: the point is to prove that this package typechecks on its own
  // terms rather than because the Next application lends it aliases, ambient
  // generated types, or its TypeScript plugin. The base deliberately carries no
  // `lib`, `types`, `jsx`, `paths` or plugins, so extending it grants nothing.
  // `pnpm typecheck` in this package runs it — the root's recursive typecheck
  // reaches it without naming the package — so package-internal files that no
  // application file imports are still covered.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2022 + DOM, not the Next lib set. DOM is the only library that declares
    // the web-standard globals a universal package may use (`URL` is the one in
    // play today); it is NOT permission to touch `document`/`window`, which
    // `pnpm lint:package-boundaries` rejects along with the Node-only globals.
    "lib": ["ES2022", "DOM"],
    // `@types/node` is present for TYPE positions only: the provider seam names
    // `Buffer` where image bytes cross it. Evaluating a Node-only global is a
    // boundary violation the import checker fails on, so this cannot quietly
    // become a Node dependency.
    "types": ["node"]
  },
  // `vitest.config.ts` is listed so the package's own test config is covered by
  // a project: type-aware ESLint parses only files a tsconfig claims, and an
  // unclaimed config file fails the lint gate rather than going unchecked.
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
