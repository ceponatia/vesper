{
  // The package's own TypeScript project. Like the other packages it extends
  // only tsconfig.base.json — the language level and strictness contract — and
  // never the application project: the point is to prove the transport
  // typechecks on its own terms rather than because the Next application lends
  // it aliases or ambient generated types. Root `pnpm typecheck` runs it
  // alongside the others.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2022 + DOM, and here DOM is load-bearing rather than a concession: the
    // transport IS the web platform — `fetch`, `Response`, `FormData`, `Blob`,
    // `RequestInit`, `AbortSignal`, `URL`. This package is deliberately
    // server-only (`@vesper/image-replicate` is ranked `server` in the workspace
    // layer policy), so unlike image-core and contracts it may also evaluate
    // Node globals; `Buffer` is the one it does.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
