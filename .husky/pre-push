# Push gate. GitHub Actions CI is gone (out of minutes), so this hook is what
# stands between broken code and the remote: it runs the full serial gate suite
# (scripts/verify.sh) before anything is uploaded.
#
# It is deliberately scoped, so it is not a tax on every push:
#   - documentation-only pushes (docs/** and *.md) skip the gates entirely
#   - branch deletions skip
#   - VESPER_SKIP_GATES=1 git push, or git push --no-verify, opts out — for when
#     you have just run `pnpm verify` yourself and don't want to pay twice
set -eu

if [ "${VESPER_SKIP_GATES:-}" = "1" ]; then
  echo "pre-push: VESPER_SKIP_GATES=1 — gates skipped."
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
changed_list=$(mktemp)
trap 'rm -f "$changed_list"' EXIT

# git feeds one "<local ref> <local oid> <remote ref> <remote oid>" line per ref
# being pushed. An all-zero oid means "absent": on the local side a deletion, on
# the remote side a branch that does not exist there yet.
pushing=0
while read -r _local_ref local_oid _remote_ref remote_oid; do
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;; # branch deletion — nothing to verify
  esac

  pushing=1

  case "$remote_oid" in
    *[!0]*)
      range="$remote_oid..$local_oid"
      ;;
    *)
      # New branch on the remote: verify what it adds over the default branch.
      base=$(git merge-base "$local_oid" origin/main 2>/dev/null || true)
      if [ -n "$base" ]; then
        range="$base..$local_oid"
      else
        range="$local_oid"
      fi
      ;;
  esac

  git diff --name-only "$range" >>"$changed_list"
done

[ "$pushing" = 1 ] || exit 0

# Documentation-only pushes need no code gates.
code_changed=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    docs/* | *.md) ;;
    *) code_changed=1 ;;
  esac
done <"$changed_list"

if [ "$code_changed" = 0 ]; then
  echo "pre-push: documentation-only change — code gates skipped."
  exit 0
fi

if [ ! -d "$repo_root/node_modules" ]; then
  echo "pre-push: no node_modules in $repo_root — cannot verify this push." >&2
  echo "          Run \`pnpm install\` here, or push with --no-verify and run" >&2
  echo "          \`pnpm verify\` from a checkout that has dependencies." >&2
  exit 1
fi

echo "pre-push: running the full gate suite (pnpm verify) — this replaces CI."
bash "$repo_root/scripts/verify.sh" all
